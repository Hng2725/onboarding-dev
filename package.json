{
  "name": "ai.privos.mcp-app-onboarding-dev",
  "version": "2.20.0",
  "type": "module",
  "private": false,
  "description": "Onboard room members with required learning materials, knowledge checks, essay feedback, and Admin evaluations in PrivOS.",
  "title": "PrivOS Onboarding MCP App (Dev)",
  "icon": "/public/icon.svg",
  "homepage": "https://privos.ai",
  "author": {
    "name": "PrivOS AI",
    "email": "dev@privos.ai",
    "url": "https://privos.ai"
  },
  "license": "MIT",
  "dockerfilePath": "Dockerfile",
  "keywords": [
    "onboarding",
    "learning",
    "training",
    "mcp",
    "privos",
    "employee"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hng2725/onboarding-dev.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build && tsx scripts/generate-manifest.ts && npm run manifest:lint",
    "dev": "PRIVOS_TRANSPORT=relay PRIVOS_DEV_UI=1 tsx src/server.ts",
    "start": "tsx src/server.ts",
    "pair": "tsx scripts/pair.ts",
    "start:relay": "PRIVOS_TRANSPORT=relay npm start",
    "start:standalone": "NODE_ENV=production npm start",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "verify:fast-pr": "npm run typecheck:strict-unused && npm run test && npm run build && npm run preflight",
    "manifest:lint": "privos-app lint privos-app.json",
    "bundle:ui": "privos-app bundle-ui --dist dist/ui --out ui-bundle.tar",
    "preflight": "tsx scripts/preflight.ts",
    "package": "bash scripts/package-source.sh",
    "publish:marketplace": "privos-app publish",
    "docker:build": "bash scripts/build-marketplace-image.sh privos-onboarding:local",
    "docker:run": "docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 100 --tmpfs /tmp -e PORT=3000 privos-onboarding:local"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@privos_ai/app-server": "^0.11.1",
    "dotenv": "^17.3.1",
    "mammoth": "^1.13.0",
    "pdfmake": "0.3.11",
    "tsx": "^4.0.0",
    "unpdf": "^1.9.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@privos_ai/app-react": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-test-renderer": "^18.3.1",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
