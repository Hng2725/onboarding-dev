{
  "schemaVersion": 3,
  "kind": "mcp-app",
  "name": "ai.privos.mcp-app-onboarding-dev",
  "version": "2.20.0",
  "title": "PrivOS Onboarding MCP App (Dev)",
  "description": "Onboard room members with required learning materials, knowledge checks, essay feedback, and Admin evaluations in PrivOS.",
  "icon": "/public/icon.svg",
  "author": {
    "name": "PrivOS AI",
    "email": "dev@privos.ai",
    "website": "https://privos.ai"
  },
  "homepage": "https://privos.ai",
  "repository": "https://github.com/Hng2725/onboarding-dev.git",
  "permissions": [
    {
      "scope": "basic:information",
      "requirement": "required",
      "context": "room",
      "executionContext": "both",
      "feature": "onboarding.context",
      "reason": "Load the approved PrivOS installation and room context for onboarding."
    },
    {
      "scope": "bot:room:join",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.bot.join",
      "reason": "Join the installation-owned onboarding service bot to the current room before room-scoped database calls."
    },
    {
      "scope": "rooms:roles:read",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.roles",
      "reason": "Use Hub-signed room and workspace roles to separate Admin and Learner access."
    },
    {
      "scope": "rooms:read",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.members",
      "reason": "List and validate current-room members before an Admin assigns onboarding."
    },
    {
      "scope": "notifications:write",
      "requirement": "optional",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.notifications",
      "reason": "Notify assigned members, send due reminders, and announce published evaluations.",
      "degradedBehavior": "Assignments, reminders, and evaluations remain saved, but the app shows that the notification could not be delivered."
    },
    {
      "scope": "files:read",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.resources.read",
      "reason": "Open room-scoped onboarding files and learning materials."
    },
    {
      "scope": "files:write",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.resources.manage",
      "reason": "Upload Admin-authored onboarding resources to the current room."
    },
    {
      "scope": "sandbox:generate",
      "requirement": "optional",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.ai.generate",
      "reason": "Generate source-grounded onboarding template drafts from Admin-provided room documents through PrivOS Sandbox.",
      "degradedBehavior": "Admins cannot create new templates until AI generation permission is granted; existing templates remain available."
    },
    {
      "scope": "sandbox:ai-chat",
      "requirement": "optional",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.ai.fallback.read",
      "reason": "Observe the exact Native AI Chat reply used when the Sandbox generation provider fails.",
      "degradedBehavior": "Sandbox generation remains available, but failed provider attempts cannot fall back to Native AI Chat."
    },
    {
      "scope": "sandbox:ai-chat:write",
      "requirement": "optional",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.ai.fallback.write",
      "reason": "Send and start a room-bound Native AI Chat generation only when retrying a failed Sandbox job.",
      "degradedBehavior": "Sandbox generation remains available, but failed provider attempts cannot fall back to Native AI Chat."
    },
    {
      "scope": "db:read",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.data.read",
      "reason": "Read room-scoped templates, assignments, progress, attempts, feedback, evaluations, and audit records."
    },
    {
      "scope": "db:write",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.data.write",
      "reason": "Persist room-scoped onboarding state through the server-side policy gateway."
    },
    {
      "scope": "db:schema:read",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.schema.read",
      "reason": "Verify the registered onboarding App Database schema for the current room."
    },
    {
      "scope": "db:schema:write",
      "requirement": "required",
      "context": "room",
      "executionContext": "user",
      "feature": "onboarding.schema.write",
      "reason": "Register versioned onboarding collections and indexes for the current room."
    }
  ],
  "dataPolicy": {
    "version": "2026-10-20",
    "retention": "Onboarding data is retained in the room-scoped App Database until the installation or corresponding records are deleted.",
    "externalProcessing": false
  },
  "availabilityTier": "single",
  "capabilities": {
    "verifiedActor": true
  },
  "agentBot": {
    "name": "PrivOS Onboarding Service",
    "slug": "privos-onboarding-service"
  },
  "tools": [
    {
      "name": "onboarding_dashboard",
      "title": "Mở PrivOS Onboarding",
      "description": "Mở giao diện onboarding theo đúng vai trò Admin hoặc nhân sự trong room hiện tại.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ui": {
        "resourceUri": "ui://ai.privos.mcp-app-onboarding-dev/form.html"
      }
    },
    {
      "name": "onboarding_bootstrap",
      "title": "Khởi tạo Onboarding",
      "description": "Xác thực vai trò, room, danh tính, capability và tải tóm tắt phù hợp với người gọi.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["load"] }
        },
        "required": ["action"]
      }
    },
    {
      "name": "onboarding_admin_templates",
      "title": "Quản lý template onboarding",
      "description": "Admin xem, chỉnh sửa, xuất bản, lưu trữ hoặc xóa template onboarding; template mới được tạo bằng AI từ tài liệu Admin cung cấp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["list", "get", "update", "publish", "archive", "delete"] },
          "templateId": { "type": "string" },
          "version": { "type": "number" },
          "expectedUpdatedAt": { "type": "string" },
          "draft": { "type": "object" }
        },
        "required": ["action"]
      }
    },
    {
      "name": "onboarding_admin_ai",
      "title": "Tạo lộ trình onboarding bằng AI",
      "description": "Admin quản lý tài liệu nguồn, điều phối job AI và rà soát template được tạo có dẫn chứng.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list_sources", "ingest_source", "add_admin_note", "delete_source", "get_source_section",
              "start_job", "list_jobs", "get_job", "next_step", "record_dispatch", "submit_ai_output",
              "report_ai_failure", "retry_job", "cancel_job", "record_attempt_cleanup", "get_review", "update_review", "resolve_flag"
            ]
          },
          "operationId": { "type": "string" },
          "fileName": { "type": "string" },
          "mimeType": { "type": "string" },
          "base64": { "type": "string" },
          "fileId": { "type": "string" },
          "systemName": { "type": "string" },
          "softwareVersion": { "type": "string" },
          "effectiveDate": { "type": "string" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "sourceId": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "sectionId": { "type": "string" },
          "kind": { "type": "string" },
          "job": { "type": "object" },
          "jobId": { "type": "string" },
          "inventoryJobId": { "type": "string" },
          "templateKind": { "type": "string", "enum": ["normal", "advanced"] },
          "roleProfile": { "type": "object" },
          "workerId": { "type": "string" },
          "callId": { "type": "string" },
          "attemptRef": { "type": "string" },
          "provider": { "type": "string", "enum": ["sandbox", "native_chat"] },
          "state": { "type": "string", "enum": ["confirmed", "unknown"] },
          "reason": { "type": "string", "enum": ["failed", "cancelled", "timeout", "dispatch_unknown"] },
          "message": { "type": "string" },
          "templateId": { "type": "string" },
          "version": { "type": "number" },
          "expectedUpdatedAt": { "type": "string" },
          "ops": { "type": "array", "items": { "type": "object" } },
          "flagId": { "type": "string" },
          "resolutionAction": { "type": "string", "enum": ["choose_option", "add_note", "upload_doc", "remove", "accept"] },
          "note": { "type": "string" },
          "chosenEvidenceIndex": { "type": "number" }
        },
        "required": ["action"]
      }
    },
    {
      "name": "onboarding_admin_assignments",
      "title": "Quản lý nhân sự onboarding",
      "description": "Admin xem thành viên room, gán onboarding thủ công, theo dõi tiến độ, nhắc hạn và cấp lượt làm lại.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["list", "get", "list_members", "list_employees", "add_employee", "assign", "grant_retry", "grant_module_retry", "question_stats", "send_due_reminders"] },
          "assignmentId": { "type": "string" },
          "memberId": { "type": "string" },
          "employeeType": { "type": "string", "enum": ["normal", "advanced"] },
          "templateId": { "type": "string" },
          "templateVersion": { "type": "number" },
          "version": { "type": "number" },
          "moduleId": { "type": "string" },
          "dueAt": { "type": "string" },
          "at": { "type": "string" }
        },
        "required": ["action"]
      }
    },
    {
      "name": "onboarding_learning",
      "title": "Học và làm bài onboarding",
      "description": "Nhân sự xem tài liệu, ghi nhận hoàn thành, lưu bài nháp, nộp bài và xem kết quả của chính mình.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["list", "get", "open_resource", "complete_resource", "start_attempt", "save_draft", "submit", "get_result", "get_feedback", "get_modules", "open_module", "complete_lesson", "start_module_quiz", "submit_module_quiz", "get_module_attempt"] },
          "memberId": { "type": "string" },
          "assignmentId": { "type": "string" },
          "resourceId": { "type": "string" },
          "moduleId": { "type": "string" },
          "attemptId": { "type": "string" },
          "operationId": { "type": "string" },
          "answers": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["action"]
      }
    },
    {
      "name": "onboarding_reviews",
      "title": "Nhận xét và đánh giá onboarding",
      "description": "Admin nhận xét từng câu tự luận và công bố đánh giá chung với kết luận Đạt, Không đạt hoặc Làm lại.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["list_essays", "save_essay_feedback", "list_evaluations", "publish_evaluation"] },
          "attemptId": { "type": "string" },
          "answerId": { "type": "string" },
          "comment": { "type": "string" },
          "operationId": { "type": "string" },
          "completionLevel": { "type": "string" },
          "strengths": { "type": "string" },
          "improvements": { "type": "string" },
          "publicComment": { "type": "string" },
          "conclusion": { "type": "string", "enum": ["passed", "failed", "retry"] }
        },
        "required": ["action"]
      }
    }
  ],
  "port": 3000,
  "resources": {
    "memoryMb": 256,
    "cpus": 0.25,
    "tmpSizeMb": 64
  },
  "volumes": [],
  "stateless": true,
  "env": [
    {
      "key": "PRIVOS_AGENT_BOT_CREDENTIAL",
      "description": "Hub credential used only by the app backend for room-scoped App Database and notification calls.",
      "required": false,
      "secret": true
    },
    {
      "key": "PRIVOS_AGENT_BOT_USER_ID",
      "description": "User id paired with the app service credential for authenticated Hub calls.",
      "required": false,
      "secret": false
    }
  ],
  "resourceManifestTemplate": [],
  "ui": {
    "distDir": "dist/ui"
  }
}
